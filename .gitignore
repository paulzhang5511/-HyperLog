/target

# 打包产物（scripts/package_macos.sh 产出：HyperLog.app / *.zip）
/dist/

# 工作台数据（记忆、会话状态），不入库
/.workbuddy/

# 本地生成的大样本日志（scripts/gen_log.sh 产出目录）
/tmp/
/bench/

# 本地测试日志样本（scripts/gen_sample_logs.py 产出，含 1GB 压测文件，不入库）
/sample_logs/

# 导出过程中的临时文件
*.log.tmp

.DS_Store

# 字体：只提交实际嵌入的字重（NotoSerifSC-Regular + SauceCodeProNerdFont-Regular），
# 其余字重变体（Bold/Black/Italic 等）体积大且当前未用，本地保留但入库。
/assets/fonts/*.ttf
!/assets/fonts/NotoSerifSC-Regular.ttf
!/assets/fonts/SauceCodeProNerdFont-Regular.ttf
