/target

# 打包产物（scripts/package_macos.sh 产出：HyperLog.app / *.zip）
/dist/

# 工作台数据（记忆、会话状态），不入库
/.workbuddy/

# 本地生成的大样本日志（scripts/gen_log.sh 产出目录）
/tmp/
/bench/

# 本地测试日志样本（scripts/gen_sample_logs.py 产出，含 1GB 压测文件，不入库）
/sample_logs/

# 导出过程中的临时文件
*.log.tmp

.DS_Store

# 字体：只提交实际嵌入的字重（NotoSerifSC-Medium 中文兜底 + SauceCodeProNerdFont
# Regular 正文 / Bold 命中强调），其余字重变体每个 2–14MB，本地保留但不入库。
# 注意：负向 `!` 能生效的前提是父目录 /assets/fonts/ 本身未被忽略。
/assets/fonts/*.ttf
!/assets/fonts/NotoSerifSC-Medium.ttf
!/assets/fonts/SauceCodeProNerdFont-Regular.ttf
!/assets/fonts/SauceCodeProNerdFont-Bold.ttf
